diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index f02eae97ae0c762fbf09233bc8fb32c996b0639f..fecba204f93e6df6a62f8cf656da985bbdc830cc 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -2,6 +2,7 @@ package net.minecraft.world.entity;
 
 import com.google.common.annotations.VisibleForTesting;
 import com.google.common.collect.Maps;
+import io.splatage.leaf.config.modules.entities.MobAiThrottleConfig;
 import io.splatage.leaf.config.modules.spawning.PickupPersistenceExpiry;
 import it.unimi.dsi.fastutil.objects.Object2IntMap.Entry;
 import java.util.ArrayList;
@@ -899,12 +900,24 @@ public abstract class Mob extends LivingEntity implements EquipmentUser, Leashab
             return;
         }
         // Paper end - Allow nerfed mobs to jump and float
+
+        // Splatage start - Failed-navigation AI throttle
+        if (this.navigation.isFailedNavigationAiThrottleActive(MobAiThrottleConfig.skipDurationTicks)) {
+            if (this.goalFloat != null) {
+                if (this.goalFloat.canUse()) this.goalFloat.tick();
+                this.getJumpControl().tick();
+            }
+            return;
+        }
+        // Splatage end - Failed-navigation AI throttle
+
         ProfilerFiller profilerFiller = Profiler.get();
         profilerFiller.push("sensing");
         this.sensing.tick();
         profilerFiller.pop();
-        int i = this.tickCount + this.getId();
-        if (i % 2 != 0 && this.tickCount > 1) {
+
+        final int i = this.tickCount + this.getId();
+        if (this.tickCount > 1 && i % MobAiThrottleConfig.fullAiStepInterval != 0) {
             profilerFiller.push("targetSelector");
             this.targetSelector.tickRunningGoals(false);
             profilerFiller.pop();
diff --git a/net/minecraft/world/entity/ai/goal/GoalSelector.java b/net/minecraft/world/entity/ai/goal/GoalSelector.java
index 0938c1ab06878a62bd734255d1963001db7cea19..bd406e662a4c4df64c66c84bdc9ad58c63ff7a1d 100644
--- a/net/minecraft/world/entity/ai/goal/GoalSelector.java
+++ b/net/minecraft/world/entity/ai/goal/GoalSelector.java
@@ -6,6 +6,7 @@ import java.util.EnumSet;
 import java.util.Map;
 import java.util.Set;
 import java.util.function.Predicate;
+import io.splatage.leaf.config.modules.entities.MobAiThrottleConfig;
 import net.minecraft.util.profiling.Profiler;
 import net.minecraft.util.profiling.ProfilerFiller;
 
@@ -27,6 +28,7 @@ public class GoalSelector {
     private static final Goal.Flag[] GOAL_FLAG_VALUES = Goal.Flag.values(); // Paper - remove streams from GoalSelector
     private final ca.spottedleaf.moonrise.common.set.OptimizedSmallEnumSet<net.minecraft.world.entity.ai.goal.Goal.Flag> goalTypes = new ca.spottedleaf.moonrise.common.set.OptimizedSmallEnumSet<>(Goal.Flag.class); // Paper - remove streams from GoalSelector
     private int curRate; // Paper - EAR 2
+    private int splatageGoalAiUpdateCounter;
     private final int[] lockedPriorities = new int[GOAL_FLAG_VALUES.length]; // Leaf - optimize goal selector
 
     public void addGoal(int priority, Goal goal) {
@@ -135,41 +137,43 @@ public class GoalSelector {
         profilerFiller.pop();
         profilerFiller.push("goalUpdate");
 
-        // Leaf start - optimize goal selector
-        for (int i = 0; i < elemSize; i++) {
-            final WrappedGoal goal = elements[i];
-            if (goal.isRunning()) {
-                continue;
-            }
-            final long f = goal.goal.getFlags().getBackingSet();
-            final int p = goal.getPriority();
-            if ((disabled & f) != 0L
-                || (f & mask) != 0L
-                && ((f & 1L) != 0L && p >= lockedPriorities[0]
-                || (f & 2L) != 0L && p >= lockedPriorities[1]
-                || (f & 4L) != 0L && p >= lockedPriorities[2]
-                || (f & 8L) != 0L && p >= lockedPriorities[3]
-                || (f & 16L) != 0L && p >= lockedPriorities[4])) {
-                continue;
-            } else if (!goal.canUse()) {
-                continue;
-            }
-            for (long iter = f; iter != 0L; iter &= iter - 1) {
-                final int j = Long.numberOfTrailingZeros(iter);
-                final Goal.Flag flag = GOAL_FLAG_VALUES[j];
-                final WrappedGoal locked = lockedFlags.get(flag);
-                if (locked != null) {
-                    locked.stop();
+        if (this.splatageGoalAiUpdateCounter++ % MobAiThrottleConfig.goalAiUpdateInterval == 0) {
+            // Leaf start - optimize goal selector
+            for (int i = 0; i < elemSize; i++) {
+                final WrappedGoal goal = elements[i];
+                if (goal.isRunning()) {
+                    continue;
                 }
-                lockedFlags.put(flag, goal);
-                lockedPriorities[j] = goal.isInterruptable()
-                    ? goal.getPriority()
-                    : Integer.MIN_VALUE;
-                mask |= (1L << j);
+                final long f = goal.goal.getFlags().getBackingSet();
+                final int p = goal.getPriority();
+                if ((disabled & f) != 0L
+                    || (f & mask) != 0L
+                    && ((f & 1L) != 0L && p >= lockedPriorities[0]
+                    || (f & 2L) != 0L && p >= lockedPriorities[1]
+                    || (f & 4L) != 0L && p >= lockedPriorities[2]
+                    || (f & 8L) != 0L && p >= lockedPriorities[3]
+                    || (f & 16L) != 0L && p >= lockedPriorities[4])) {
+                    continue;
+                } else if (!goal.canUse()) {
+                    continue;
+                }
+                for (long iter = f; iter != 0L; iter &= iter - 1) {
+                    final int j = Long.numberOfTrailingZeros(iter);
+                    final Goal.Flag flag = GOAL_FLAG_VALUES[j];
+                    final WrappedGoal locked = lockedFlags.get(flag);
+                    if (locked != null) {
+                        locked.stop();
+                    }
+                    lockedFlags.put(flag, goal);
+                    lockedPriorities[j] = goal.isInterruptable()
+                        ? goal.getPriority()
+                        : Integer.MIN_VALUE;
+                    mask |= (1L << j);
+                }
+                goal.start();
             }
-            goal.start();
+            // Leaf end - optimize goal selector
         }
-        // Leaf end - optimize goal selector
 
         profilerFiller.pop();
         this.tickRunningGoals(true);
diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index 6893ac65206ffa2357aa5f725227d5be4b3364a3..2cbb7ab6f8f9db907022e21e9a3921dda921d03e 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -221,10 +221,22 @@ public abstract class PathNavigation {
     }
 
     // Paper start - Perf: Optimise pathfinding
-    private int lastFailure = 0;
+    private long lastFailure = 0;
     private int pathfindFailures = 0;
     // Paper end - Perf: Optimise pathfinding
 
+    // Splatage start - Failed-navigation AI throttle
+    public boolean isFailedNavigationAiThrottleActive(final int skipDurationTicks) {
+        if (skipDurationTicks <= 0) {
+            return false;
+        }
+
+        return this.pathfindFailures > 10
+            && this.path == null
+            && net.minecraft.server.MinecraftServer.currentTick < this.lastFailure + skipDurationTicks;
+    }
+    // Splatage end - Failed-navigation AI throttle
+
     public boolean moveTo(double x, double y, double z, double speedModifier) {
         return this.moveTo(this.createPath(x, y, z, 1), speedModifier);
     }
