+    public boolean canSpawn(MobCategory category, ChunkPos pos, ServerLevel level) {
+        final int spawnLimit = HostileSpawnDensityHelper.resolveChunkLimit(level, pos, category, category.getMaxInstancesPerChunk());
+
+        for (ServerPlayer serverPlayer : this.getPlayersNear(pos)) {
+            LocalMobCapCalculator.MobCounts mobCounts = this.playerMobCounts.get(serverPlayer);
