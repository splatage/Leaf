+        private static void handleRewardedPlayersReset(ServerLevel level, BlockState state, VaultServerData serverData) {
+            if (!TrialVaultResetConfig.enabled || TrialVaultResetConfig.resetAfterTicks <= 0L) {
+                serverData.clearRewardedPlayersResetSchedule();
+                return;
+            }
+
+            if (!serverData.hasRewardedPlayersResetScheduled()) {
+                return;
+            }
+
+            if (level.getGameTime() < serverData.rewardedPlayersResetAt()) {
+                return;
+            }
+
+            VaultState vaultState = state.getValue(VaultBlock.STATE);
+            if (vaultState == VaultState.UNLOCKING || vaultState == VaultState.EJECTING) {
+                return;
+            }
+
+            if (!serverData.getItemsToEject().isEmpty()) {
+                return;
+            }
+
+            serverData.clearRewardedPlayersForReset();
+            serverData.pauseStateUpdatingUntil(level.getGameTime());
+        }
+
+        private static void updateRewardedPlayersResetSchedule(long gameTime, VaultServerData serverData) {
+            if (TrialVaultResetConfig.enabled && TrialVaultResetConfig.resetAfterTicks > 0L) {
+                serverData.scheduleRewardedPlayersResetAt(gameTime + TrialVaultResetConfig.resetAfterTicks);
+            } else {
+                serverData.clearRewardedPlayersResetSchedule();
+            }
+        }
+
         private static void playInsertFailSound(ServerLevel level, VaultServerData serverData, BlockPos pos, SoundEvent sound) {
