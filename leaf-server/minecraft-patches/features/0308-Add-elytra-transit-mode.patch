+        private boolean isChunkInElytraGenerationCorridor(final int chunkX, final int chunkZ) {
+            final int relativeChunkX = chunkX - this.lastChunkX;
+            final int relativeChunkZ = chunkZ - this.lastChunkZ;
+            final int forwardDepthChunks = ElytraTransit.glideCorridorDepthChunks;
+
+            if (forwardDepthChunks <= 0) {
+                return relativeChunkX == 0 && relativeChunkZ == 0;
+            }
+
+            final double yawRadians = Math.toRadians(this.player.getYRot());
+            final double forwardX = -Math.sin(yawRadians);
+            final double forwardZ = Math.cos(yawRadians);
+
+            final double forwardDistance = relativeChunkX * forwardX + relativeChunkZ * forwardZ;
+            if (forwardDistance < 0.0D || forwardDistance > (double) forwardDepthChunks) {
+                return false;
+            }
+
+            final double lateralDistance = Math.abs(relativeChunkX * (-forwardZ) + relativeChunkZ * forwardX);
+            return lateralDistance <= (double) ElytraTransit.glideCorridorHalfWidthChunks;
+        }
+
+        private boolean shouldQueueLoadedChunkForGeneration(final int chunkX, final int chunkZ, final ChunkAccess chunkAccess, final boolean elytraGenerationCorridor) {
+            if (this.isLoadedChunkGeneratable(chunkAccess)) {
+                return true;
+            }
+
+            if (!this.canGenerateChunks) {
+                return false;
+            }
+
+            return !elytraGenerationCorridor || this.isChunkInElytraGenerationCorridor(chunkX, chunkZ);
+        }
+
+        private boolean shouldQueueLoadedChunkForGeneration(final int chunkX, final int chunkZ, final boolean elytraGenerationCorridor) {
+            return this.shouldQueueLoadedChunkForGeneration(
+                chunkX,
+                chunkZ,
+                ((ChunkSystemLevel)this.world).moonrise$getAnyChunkIfLoaded(chunkX, chunkZ),
+                elytraGenerationCorridor
+            );
+        }
+
         private Packet<?> updateClientChunkRadius(final int radius) {
             this.lastSentChunkRadius = radius;
             return new ClientboundSetChunkCacheRadiusPacket(radius);
