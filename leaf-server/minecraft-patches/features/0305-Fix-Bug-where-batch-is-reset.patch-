From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: splatage <noj.melville@gmail.com>
Date: Thu, 12 Mar 2026 12:45:09 +1300
Subject: [PATCH] Fix Bug where batch is reset


diff --git a/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java b/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
index b67ffd5f32291a3f02909d1a8b2dbf16f7c7e0b1..fd64936094a12d167235c15d4ea67dc10c0a7b37 100644
--- a/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
+++ b/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
@@ -403,10 +403,9 @@ public class TransportItemsBetweenContainers extends Behavior<PathfinderMob> {
                             );
                             if (lockedTarget != null) {
                                 if (!matchesLeavingItemsRequirement(mob, lockedTarget.container)) {
+                                    // Old destination lock is stale for the current hand item.
+                                    // Clear only the destination lock; preserve the current batch item.
                                     paperClearDestinationLock(golem, now);
-                                    if (CopperGolemConfig.rememberLastItem) {
-                                        paperClearLastItemMemory(golem, now);
-                                    }
                                 } else {
                                     return Optional.of(lockedTarget);
                                 }
