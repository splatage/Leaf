     protected void pickUpItem(ServerLevel level, ItemEntity entity) {
+        final boolean wasPersistenceRequired = this.isPersistenceRequired();
+        final boolean hadCustomPersistence = this.requiresCustomPersistence();
+
         ItemStack item = entity.getItem();
         ItemStack itemStack = this.equipItemIfPossible(level, item.copy(), entity); // CraftBukkit - add item
         if (!itemStack.isEmpty()) {
+            if (!wasPersistenceRequired && !hadCustomPersistence && this.paper$isEligibleForTemporaryPickupPersistence()) {
+                this.paper$markTemporaryPickupPersistence(level);
+            }
+
             this.onItemPickup(entity);
             this.take(entity, itemStack.getCount());
             item.shrink(itemStack.getCount());
@@ -777,6 +794,59 @@ public abstract class Mob extends LivingEntity implements EquipmentUser, Leashab
         return this.isPassenger();
     }
 
+    private boolean paper$isEligibleForTemporaryPickupPersistence() {
+        if (!PickupPersistenceExpiry.enabled || PickupPersistenceExpiry.ticks <= 0) {
+            return false;
+        }
+        if (PickupPersistenceExpiry.monstersOnly && this.getType().getCategory() != MobCategory.MONSTER) {
+            return false;
+        }
+        if (PickupPersistenceExpiry.naturalAndChunkGenerationOnly) {
+            final CreatureSpawnEvent.SpawnReason spawnReason = this.spawnReason;
+            if (spawnReason == null) {
+                return false;
+            }
+            if (spawnReason != CreatureSpawnEvent.SpawnReason.NATURAL
+                && spawnReason != CreatureSpawnEvent.SpawnReason.CHUNK_GEN) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    private void paper$markTemporaryPickupPersistence(ServerLevel level) {
+        this.paper$temporaryPickupPersistence = true;
+        this.paper$pickupPersistenceExpiresAt = level.getGameTime() + PickupPersistenceExpiry.ticks;
+    }
+
+    private boolean paper$hasExplicitPickupPersistenceExemption() {
+        return this.hasCustomName() || this.isLeashed() || this.isVehicle();
+    }
+
+    private boolean paper$shouldBlockNaturalDespawn(ServerLevel level) {
+        if (this.requiresCustomPersistence()) {
+            return true;
+        }
+        if (this.paper$hasExplicitPickupPersistenceExemption()) {
+            return true;
+        }
+        if (!this.isPersistenceRequired()) {
+            return false;
+        }
+        if (!this.paper$temporaryPickupPersistence) {
+            return true;
+        }
+        if (level.getGameTime() < this.paper$pickupPersistenceExpiresAt) {
+            return true;
+        }
+
+        this.paper$temporaryPickupPersistence = false;
+        this.paper$pickupPersistenceExpiresAt = 0L;
+        this.persistenceRequired = false;
+        return false;
+    }
+
     // Paper start - allow changing despawnInPeaceful
     public final boolean shouldDespawnInPeaceful() {
         return this.despawnInPeacefulOverride.toBooleanOrElse(!this.getType().isTypeAllowedInPeaceful());
